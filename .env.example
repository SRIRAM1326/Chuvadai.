# Flask
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=20

# OCR behaviour: auto | cloud | local
# auto  -> use BharatOCR Cloud when credentials exist, otherwise use local OCR
# cloud -> require BharatOCR Cloud (no silent local fallback)
# local -> never call the cloud API
BHARATOCR_MODE=auto

# BharatOCR API credentials. Use either an API key or email/password login.
BHARATOCR_API_KEY=
BHARATOCR_EMAIL=
BHARATOCR_PASSWORD=

# BharatOCR API endpoints
# Set BHARATOCR_API_URL to call a custom/generic OCR endpoint directly.
# Leave blank to build: {BHARATOCR_API_BASE}/{BHARATOCR_ENDPOINT}
BHARATOCR_API_BASE=https://api.essentiasoftserv.com/api/v1
BHARATOCR_API_URL=
BHARATOCR_ENDPOINT=ocr
BHARATOCR_FILE_FIELD=file

# Optional BharatOCR document-specific endpoint, e.g. pan, passport, degree.
# When set it overrides BHARATOCR_ENDPOINT and uses "image" as the form field.
BHARATOCR_DOCUMENT_TYPE=

# Send every PDF page to the cloud even when the PDF already has a text layer.
BHARATOCR_FORCE_CLOUD=false
BHARATOCR_TIMEOUT=60

# PDF rendering and local OCR
OCR_DPI=200
PDF_TEXT_MIN_CHARS=30
TESSERACT_LANG=eng
WINOCR_LANG=en
